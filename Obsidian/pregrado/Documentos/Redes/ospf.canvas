		{"id":"ea02ffd1cb251054","type":"text","text":"Distance Vector","x":125,"y":-100,"width":250,"height":60},
		{"id":"c971905a077a743a","type":"text","text":" EIGRP(Protocolo de Enrutamiento de Gateway Interior Mejorado)","x":461,"y":-3,"width":250,"height":60},
		{"id":"54ba438d6ce7440c","type":"text","text":"RIP","x":461,"y":-100,"width":250,"height":60},
		{"id":"c46ed812f963ea9d","type":"text","text":"Se basa en el número de saltos para decidir cuál es la mejor ruta hacia una red de destino","x":815,"y":-105,"width":405,"height":65},
		{"id":"57271ced57744534","type":"text","text":"usa una distancia adm de 110  predeterminada","x":-940,"y":-3,"width":250,"height":60},
		{"id":"f5f81db137f81170","type":"text","text":"utliza la direccion de multicast: 224.0.0.5 IPV4 y en IPV6 FF02::5","x":-590,"y":80,"width":250,"height":60},
		{"id":"1ad175902ff11723","type":"text","text":"Base de datos de reenvio","x":-515,"y":930,"width":250,"height":60},
		{"id":"8ec487bb477d694a","type":"text","text":"Base de datos de adyacencia","x":-1070,"y":935,"width":250,"height":60},
		{"id":"07ea52df75d729bd","type":"text","text":"Base de datos de estado de enlace(LSBD)","x":-785,"y":935,"width":250,"height":60},
		{"id":"49ec1247147bf6e0","type":"text","text":"crea la tabla de vecinos","x":-1068,"y":1043,"width":250,"height":60},
		{"id":"4373d107f67249c7","type":"text","text":"crea la tabla de topologia","x":-785,"y":1043,"width":250,"height":60},
		{"id":"932350a34ff5aaab","type":"text","text":"crea la tabla de routing ","x":-515,"y":1043,"width":250,"height":60},
		{"id":"5d6cb8d7a6299a20","type":"text","text":"estructura de datos","x":-785,"y":790,"width":250,"height":60},
		{"id":"686b76efaacc288d","type":"text","text":"Componentes OSPF","x":-785,"y":633,"width":250,"height":60},
		{"id":"e643e1d9b803fe23","type":"text","text":"estas tablascontienen una lsita de routers vecinos para intervambiar inforamcion de rounting y se guardan y manteienne en ram","x":-852,"y":1220,"width":384,"height":113},
		{"id":"01abcd1176a56262","type":"text","text":"sh ip ospf neighbor","x":-1380,"y":880,"width":250,"height":60},
		{"id":"826425a6b530f32f","type":"text","text":"sh ip ospf database","x":-1380,"y":770,"width":250,"height":60},
		{"id":"699e48e69fba8d06","type":"text","text":"sh ip route","x":-220,"y":930,"width":250,"height":60},
		{"id":"4c534f0e18895421","type":"text","text":"a fin de mantener la informacion de routing los routers realizan un estado generico para alcanzar un estado de convergencia","x":-856,"y":1400,"width":392,"height":92},
		{"id":"8ca17631dbcd45d1","type":"text","text":"intercambio de notificaciones de estado de enlace (lsa) los anunciones contienen el estado y el costo de cada enlace conectado directamiente ","x":445,"y":180,"width":476,"height":85},
		{"id":"a1a4ff781fe1c718","type":"text","text":"un area ospf quiere decir que comparten la misma informacion de estado enlace ensu base de datos de estado de enalce ","x":-963,"y":1613,"width":343,"height":127},
		{"id":"1aad636d87b6974f","type":"text","text":"OSPF area unica","x":-488,"y":1602,"width":250,"height":60},
		{"id":"7669421cba1bc003","type":"text","text":"todos los routers se encuentra en un area llamada backbone o area 0 \n","x":-194,"y":1596,"width":334,"height":66},
		{"id":"d5ad4604cb835a83","type":"text","text":"ospf multiarea","x":-423,"y":1721,"width":250,"height":60},
		{"id":"f26f9eacd8364489","type":"text","text":"se implementa mediantes varias areas de manera jerarquica todas las areas deben conectarse al backboine ","x":-95,"y":1698,"width":317,"height":106},
		{"id":"008da6a0de849862","type":"text","text":"los routers que conectan las areas se llaman routers fronterizos de area (ABR)","x":-90,"y":1886,"width":307,"height":80},
		{"id":"7d62b8177797dca1","type":"text","text":"divide sistema autonomo grande en area mas pequeña a fin de admitir el routing jerarquico","x":-515,"y":1858,"width":342,"height":108},
		{"id":"e6d8527aa22b9c41","type":"text","text":"Crear adyeciancia","x":-1240,"y":2300,"width":250,"height":60},
		{"id":"26f57d006fce9566","type":"text","text":"intercambiar informacion de routing","x":-963,"y":2300,"width":250,"height":60},
		{"id":"2704cf4680176af4","type":"text","text":"lograr la convergencia","x":-423,"y":2300,"width":250,"height":60,"color":"#38cc93"},
		{"id":"540289dd82e0d51e","type":"text","text":"calcular las mejores rutas","x":-699,"y":2300,"width":250,"height":60},
		{"id":"bf66e53a0f1e578b","type":"text","text":"no usa tcp o udp","x":-852,"y":215,"width":250,"height":50},
		{"id":"08cb5532d8677812","type":"text","text":"reenvia un paquete saludo cor la id del router por las interfaces de ospf ","x":-1585,"y":567,"width":278,"height":113},
		{"id":"52c7e1949bfa21a5","type":"text","text":"cuando se habilita ospf una interfaz el router debe determinar si existe otro vecino en el enlace ","x":-1137,"y":500,"width":317,"height":120},
		{"id":"f62b48120fa9b247","type":"text","text":"utiliza la id del router para identificar el router en el area ","x":-1630,"y":395,"width":323,"height":80},
		{"id":"365c852237defe54","type":"text","text":"el id del router es una ip asignada para identificar un router especifico entre puntos ","x":-2020,"y":550,"width":339,"height":119},
		{"id":"fe41b35e7501c88b","type":"text","text":"full","x":0,"y":825,"width":250,"height":50},
		{"id":"e6b8a67115ee5e1b","type":"text","text":"loading","x":0,"y":760,"width":250,"height":60},
		{"id":"605c4d844105203b","type":"text","text":"exchange","x":0,"y":695,"width":250,"height":60},
		{"id":"a6ac2b9395d5c62b","type":"text","text":"exstart","x":0,"y":633,"width":250,"height":60},
		{"id":"335a98d806206f9d","type":"text","text":"**2way** \nsi se interconecctan atras de enlace punto a punto pasan de una a la fase sincronizacion de base de datos\nsi los routers se interconectn a traves de la red ethernet comun se debe elegir un router designado (DR) u un router desginado de respaldo (BDR) este procesos solo tiene lugar como la redes de acceso multiples como las lan ehternet","x":-20,"y":340,"width":365,"height":278},
		{"id":"a5ff81fa3ef344d3","type":"text","text":"es imporatnte definir nuestro bdr y dr  para evitar saturacion en la red de mensajes lsa  se sigue la formula para ver cuantas adyacencias hay  N(N-1)/2","x":-447,"y":586,"width":297,"height":169},
		{"id":"f4918d48d2c135ba","type":"text","text":"init","x":-20,"y":280,"width":250,"height":60},
		{"id":"83117922f6dad9a6","type":"text","text":"down","x":-20,"y":220,"width":250,"height":60},
		{"id":"05cad5e3dee42b11","type":"text","text":"debe estar en full state el router para que funcione","x":201,"y":895,"width":260,"height":80},
		{"id":"9a1f3976151a18c4","type":"text","text":"Routing protocols","x":-680,"y":-450,"width":250,"height":60,"color":"1"},
		{"id":"29f15e86434d3e5a","type":"text","text":"EGP(Exterior Gateway Protocol)","x":-145,"y":-660,"width":250,"height":60,"color":"#d93fc5"},
		{"id":"8e2a036120f7c7dc","type":"text","text":" se utiliza para conectar diferentes redes y permite el intercambio de información sobre las rutas entre ellas","x":273,"y":-690,"width":345,"height":120},
		{"id":"3e6fc784b5a3e0fb","type":"text","text":"IGP","x":-145,"y":-330,"width":250,"height":60,"color":"#4a671e"},
		{"id":"804ff7b858abb97d","type":"text","text":"encaminar el tráfico dentro de un sistema autónomo o dentro de la infraestructura de una misma empresa.","x":170,"y":-355,"width":345,"height":110},
		{"id":"033b610508f135a3","type":"text","text":"sistema autonomo es una grupo de redes de direeciones ip que possen una clara y unica politca de ruteo","x":-738,"y":-630,"width":296,"height":125},
		{"id":"8dee80302b481faf","type":"text","text":"se basa en el retardo,ancho de banda,caarga, confiabilidad","x":641,"y":-220,"width":299,"height":65},
		{"id":"3c0e2620aba438a7","type":"text","text":"El protocolo de gateway fronterizo (BGP) es el único EGP viable actualmente y es el protocolo de routing oficial utilizado por Internet","x":-185,"y":-920,"width":331,"height":130},
		{"id":"75fbbd1133874028","type":"text","text":"vector ruta","x":-145,"y":-750,"width":250,"height":60},
		{"id":"bb5977865c2cbedc","type":"text","text":"politicas de la red \nconjutno de reglas configuradas por el admin ","x":253,"y":-865,"width":262,"height":115},
		{"id":"42f85495d29afc39","type":"text","text":"no tienen info de la red","x":290,"y":-187,"width":250,"height":60},
		{"id":"6b3f3ff5f6384ead","type":"text","text":"conergencia lenta(utiliza actualizaciones perdiodicas)\nescalabilidad limitada \nloops de enrutamiento ","x":860,"y":-3,"width":250,"height":143},
		{"id":"7c51ffada2f2ea96","type":"text","text":"usa 4 temporizadores \nactualizacion (30 sec)\ninvalidez(180 sec para marcar no valida)\npurge (240sec elimina rutas)\nespera (evita loops)","x":921,"y":-420,"width":327,"height":140},
		{"id":"86ba8bfdf473147f","type":"text","text":"Funcionamineto","x":-1088,"y":1896,"width":250,"height":60}
	],
